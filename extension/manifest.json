{
  "manifest_version": 3,
  "name": "Guardei",
  "version": "1.0.0",
  "description": "Guarde posts do Instagram, X, TikTok, YouTube e LinkedIn no Guardei com um clique.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Guardei" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "contextMenus", "alarms", "activeTab"],
  "host_permissions": [
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://firestore.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.tiktok.com/*",
        "https://www.youtube.com/*",
        "https://www.linkedin.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "guardar-aba": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Guardar a página atual" }
  }
}
